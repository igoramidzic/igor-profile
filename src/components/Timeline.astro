---
import { timeline } from '../data/timeline';
import Logo from './Logo.astro';

// Most recent first.
const entries = [...timeline].reverse();
---

<section id="timeline" class="timeline-section" aria-label="My journey">
  <div class="section-head reveal">
    <span class="section-kicker">My journey</span>
    <h2 class="section-title">
      From founder today, back to my first line of code
    </h2>
    <p class="section-sub">
      A look back at the roles, projects, and milestones that shaped me, most
      recent first.
    </p>
  </div>

  <ol class="timeline" data-timeline>
    <!-- progress rail -->
    <div class="timeline-rail" aria-hidden="true">
      <div class="timeline-line"></div>
      <div class="timeline-line-fill" data-timeline-fill></div>
    </div>

    {
      entries.map((e, i) => (
        <li
          class="t-item reveal"
          data-kind={e.kind}
          style={`--reveal-delay:${Math.min(i * 60, 240)}ms`}
        >
          <div class="t-node" aria-hidden="true">
            <span class="t-node-dot" />
          </div>

          <article class="t-card panel">
            <header class="t-card-head">
              <span class="t-logo">
                <Logo src={e.logo} alt={e.logoAlt} size={34} />
              </span>
              <div class="t-headings">
                <h3 class="t-title">{e.title}</h3>
                <p class="t-org">{e.org}</p>
              </div>
              <span class="t-date">{e.date}</span>
            </header>

            <p class="t-blurb">{e.blurb}</p>

            {e.tags && (
              <ul class="t-tags">
                {e.tags.map((tag) => (
                  <li class="t-tag">{tag}</li>
                ))}
              </ul>
            )}
          </article>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .timeline-section {
    max-width: 1100px;
    margin: 0 auto;
    padding: clamp(3rem, 8vh, 6rem) clamp(1rem, 4vw, 2rem);
  }
  .section-head {
    margin-bottom: 2.6rem;
  }
  .section-kicker {
    font-family: var(--font-mono);
    color: var(--accent);
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .section-title {
    font-size: clamp(1.5rem, 3.6vw, 2.1rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    margin-top: 0.5rem;
  }
  .section-sub {
    margin-top: 0.7rem;
    color: var(--text-dim);
    font-size: 1rem;
    max-width: 48ch;
  }
  .accent {
    color: var(--accent);
  }

  .timeline {
    position: relative;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  /* single rail down the left */
  .timeline-rail {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 9px;
    width: 2px;
  }
  .timeline-line {
    position: absolute;
    inset: 0;
    background: var(--border-strong);
  }
  .timeline-line-fill {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      var(--accent),
      var(--accent-soft)
    );
    box-shadow: 0 0 12px var(--accent-glow);
  }

  .t-item {
    position: relative;
    width: 100%;
    left: 0;
    text-align: left;
    padding: 0 0 2.4rem 2.6rem;
    box-sizing: border-box;
  }

  .t-node {
    position: absolute;
    top: 0.4rem;
    left: 1px;
    display: grid;
    place-items: center;
    width: 18px;
    height: 18px;
  }
  .t-node-dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--accent);
    box-shadow: 0 0 0 4px var(--bg), 0 0 14px var(--accent-glow);
    transition: transform 0.25s ease;
  }
  .t-item.is-visible .t-node-dot {
    background: var(--accent);
  }

  .t-card {
    display: block;
    text-align: left;
    max-width: 680px;
    padding: 1.1rem 1.2rem;
    position: relative;
    transition:
      border-color 0.25s ease,
      transform 0.25s ease;
  }
  .t-card:hover {
    border-color: var(--accent-dim);
    transform: translateY(-3px);
  }
  .t-card-head {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-bottom: 0.7rem;
  }
  .t-logo {
    flex: none;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--border);
    border-radius: 9px;
    background: var(--panel-2);
    overflow: hidden;
  }
  .t-headings {
    flex: 1;
    min-width: 0;
  }
  .t-title {
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.2;
  }
  .t-org {
    font-size: 0.84rem;
    color: var(--accent-soft);
    margin-top: 0.1rem;
  }
  .t-date {
    flex: none;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--muted);
    background: var(--panel-2);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.15rem 0.6rem;
    white-space: nowrap;
  }
  .t-blurb {
    font-size: 0.86rem;
    color: var(--text-dim);
    line-height: 1.65;
  }
  .t-tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.9rem;
    padding: 0;
  }
  .t-tag {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-dim);
    background: var(--panel-2);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.12rem 0.5rem;
  }

  /* ---- mobile tweaks ---- */
  @media (max-width: 760px) {
    .t-item {
      padding: 0 0 1.8rem 2.4rem;
    }
    .t-card-head {
      flex-wrap: wrap;
    }
    .t-date {
      order: 3;
    }
  }
</style>

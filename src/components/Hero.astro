---
// Clean profile hero: approachable intro anyone can read at a glance.
import { socials } from '../data/timeline';
import { siGithub, siLinkedin, siThreads } from 'simple-icons';

const iconPaths: Record<string, string> = {
  github: siGithub.path,
  linkedin: siLinkedin.path,
  threads: siThreads.path,
};
---

<section id="home" class="hero" aria-label="Introduction">
  <div class="hero-grid">
    <div class="intro">
      <h1 class="name reveal glow">Igor Amidzic</h1>
      <p class="role reveal">
        <span class="accent">Software Engineer</span> &amp; Founder
      </p>
      <p class="tagline reveal">
        I build polished web and mobile apps that people genuinely enjoy using.
        By day I'm a senior frontend engineer at KeyBank; on my own time I founded
        and run <a href="#kualia" class="inline-link">Kualia</a>, a budgeting app
        I designed and built from the ground up.
      </p>
      <p class="meta reveal">
        <span class="dot-live" aria-hidden="true"></span>
        Based in Tampa, Florida
      </p>
      <div class="cta reveal">
        {
          socials.map((s) => (
            <a
              class="contact-btn"
              href={s.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${s.name}: ${s.handle}`}
            >
              <svg
                class="contact-btn-icon"
                viewBox="0 0 24 24"
                width="18"
                height="18"
                aria-hidden="true"
              >
                <path fill="currentColor" d={iconPaths[s.icon]} />
              </svg>
              <span>{s.name}</span>
            </a>
          ))
        }
      </div>
    </div>

    <aside class="portrait reveal">
      <div class="photo panel" data-photo>
        <!-- Drop your photo at /public/images/igor.jpg (a square crop works
             best); it appears automatically and the placeholder hides itself. -->
        <img
          src="/images/igor.jpg"
          alt="Igor Amidzic"
          onerror="this.style.display='none';this.nextElementSibling.hidden=false"
        />
        <div
          class="photo-placeholder"
          hidden
          title="Add /public/images/igor.jpg and it appears here automatically"
        >
          <svg viewBox="0 0 24 24" width="40" height="40" aria-hidden="true">
            <path
              fill="currentColor"
              d="M12 12a5 5 0 1 0-5-5 5 5 0 0 0 5 5Zm0 2c-4 0-9 2-9 6v2h18v-2c0-4-5-6-9-6Z"
            ></path>
          </svg>
          <span>add photo</span>
        </div>
      </div>
    </aside>
  </div>

  <a href="#timeline" class="scroll-cue" aria-label="Scroll to my journey">
    <span>scroll</span>
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
      <path
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M6 9l6 6 6-6"></path>
    </svg>
  </a>
</section>

<style>
  .hero {
    max-width: 1100px;
    margin: 0 auto;
    padding: clamp(7rem, 16vh, 10rem) clamp(1rem, 4vw, 2rem) 3rem;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.4fr 0.9fr;
    gap: clamp(1.5rem, 5vw, 4rem);
    align-items: center;
  }

  .eyebrow {
    color: var(--muted);
    font-size: 0.95rem;
    letter-spacing: 0.01em;
  }
  .name {
    font-size: clamp(2.4rem, 7vw, 4rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.02;
    margin-top: 0.3rem;
  }
  .role {
    margin-top: 0.6rem;
    font-size: clamp(1.1rem, 2.6vw, 1.5rem);
    font-weight: 600;
    color: var(--text-dim);
  }
  .accent {
    color: var(--accent);
  }
  .tagline {
    margin-top: 1.3rem;
    max-width: 46ch;
    font-size: clamp(1rem, 2vw, 1.12rem);
    color: var(--text-dim);
    line-height: 1.7;
  }
  .inline-link {
    color: var(--accent-soft);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .inline-link:hover {
    color: var(--accent);
  }
  .meta {
    margin-top: 1.3rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.92rem;
    color: var(--muted);
  }
  .dot-live {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--green);
    animation: pulse 2.4s infinite;
  }
  @keyframes pulse {
    0% {
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--green) 60%, transparent);
    }
    70% {
      box-shadow: 0 0 0 9px transparent;
    }
    100% {
      box-shadow: 0 0 0 0 transparent;
    }
  }
  .cta {
    margin-top: 2rem;
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
  }
  .contact-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--text);
    background: var(--panel-2);
    border: 1px solid var(--border-strong);
    border-radius: 10px;
    padding: 0.7rem 1.2rem;
    transition:
      transform 0.15s ease,
      background 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.2s ease,
      color 0.2s ease;
  }
  .contact-btn-icon {
    color: var(--accent);
    transition: transform 0.2s ease;
  }
  .contact-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--panel);
    box-shadow: 0 12px 32px -16px var(--accent-glow);
  }

  /* ---- portrait ---- */
  .portrait {
    justify-self: center;
  }
  .photo {
    aspect-ratio: 1;
    width: clamp(200px, 80%, 320px);
    display: grid;
    place-items: center;
    overflow: hidden;
    box-shadow: 0 30px 70px -40px rgba(0, 0, 0, 0.6);
    background:
      repeating-linear-gradient(
        45deg,
        var(--panel-2),
        var(--panel-2) 12px,
        var(--panel) 12px,
        var(--panel) 24px
      );
  }
  .photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .photo-placeholder {
    display: grid;
    place-items: center;
    gap: 0.6rem;
    text-align: center;
    color: var(--muted);
    font-size: 0.78rem;
  }

  /* ---- scroll cue ---- */
  .scroll-cue {
    margin: 2.5rem auto 0;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
    color: var(--muted);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .scroll-cue svg {
    animation: bob 1.8s ease-in-out infinite;
  }
  @keyframes bob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(5px);
    }
  }

  @media (max-width: 820px) {
    .hero-grid {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .portrait {
      order: -1;
    }
    .photo {
      width: clamp(150px, 52vw, 220px);
    }
    .tagline {
      margin-left: auto;
      margin-right: auto;
    }
    .meta,
    .cta {
      justify-content: center;
    }
  }
</style>

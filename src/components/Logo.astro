---
interface Props {
  src: string | null;
  alt: string;
  size?: number;
}
const { src, alt, size = 30 } = Astro.props;
---

{
  src ? (
    <span class="logo-wrap" style={`--logo-size:${size}px`}>
      <img
        src={src}
        alt={alt}
        loading="lazy"
        decoding="async"
        onerror="this.style.display='none';this.nextElementSibling.hidden=false"
      />
      <span class="logo-fallback" hidden>{alt}</span>
    </span>
  ) : (
    <span class="logo-wrap logo-mark" style={`--logo-size:${size}px`}>
      {alt}
    </span>
  )
}

<style>
  .logo-wrap {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    min-width: var(--logo-size);
    min-height: var(--logo-size);
  }
  .logo-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .logo-fallback,
  .logo-mark {
    font-weight: 700;
    font-size: 0.8rem;
    color: var(--accent);
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
</style>

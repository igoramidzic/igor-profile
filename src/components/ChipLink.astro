---
// An inline link styled as a small pill with a logo, meant to sit inside a
// sentence. Internal links point at /<slug> pages; pass `external` for outbound
// links (e.g. kualia.com) so they open in a new tab.
interface Props {
  href: string;
  label: string;
  logo: string;
  external?: boolean;
}
const { href, label, logo, external = false } = Astro.props;
const rel = external ? 'noopener noreferrer' : undefined;
const target = external ? '_blank' : undefined;
---

<a class="chip" href={href} target={target} rel={rel}>
  <img class="chip-logo" src={logo} alt="" aria-hidden="true" loading="lazy" />
  <span>{label}</span>
  {external && <span class="chip-ext" aria-hidden="true">↗</span>}
</a>

<style>
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    vertical-align: -0.16em;
    margin: 0 0.06em;
    padding: 0.12em 0.55em 0.12em 0.45em;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: var(--panel-2);
    color: var(--text);
    font-size: 0.9em;
    line-height: 1.3;
    text-decoration: none;
    white-space: nowrap;
    transition:
      border-color 0.18s ease,
      background 0.18s ease,
      color 0.18s ease;
  }
  .chip:hover {
    border-color: var(--muted);
    background: var(--panel);
  }
  .chip-logo {
    width: 1.05em;
    height: 1.05em;
    border-radius: 50%;
    object-fit: cover;
    flex: none;
  }
  .chip-ext {
    font-size: 0.78em;
    color: var(--muted);
  }
  .chip:hover .chip-ext {
    color: var(--text-dim);
  }
</style>

---
const tabs = [
  { id: 'home', label: 'Home', href: '#home' },
  { id: 'timeline', label: 'Journey', href: '#timeline' },
  { id: 'kualia', label: 'Kualia', href: '#kualia' },
];
---

<header class="nav">
  <div class="nav-inner">
    <a href="#home" class="brand" aria-label="Igor Amidzic, home">
      <span class="brand-mark">IA</span>
      <span class="brand-name">Igor Amidzic</span>
    </a>

    <nav class="tabs" aria-label="Sections">
      {
        tabs.map((t) => (
          <a class="tab" href={t.href} data-nav={t.id}>
            {t.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--bg) 72%, transparent);
    backdrop-filter: blur(14px) saturate(180%);
    -webkit-backdrop-filter: blur(14px) saturate(180%);
    border-bottom: 1px solid var(--border);
  }
  .nav-inner {
    max-width: 1100px;
    margin: 0 auto;
    height: 56px;
    padding: 0 clamp(1rem, 4vw, 2rem);
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text);
  }
  .brand-mark {
    display: inline-grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: var(--radius-sm);
    background: var(--accent);
    color: #fff;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0;
  }
  .brand-name {
    color: var(--text);
    font-size: 0.95rem;
  }
  .tabs {
    display: flex;
    gap: 0.1rem;
    margin-left: auto;
    margin-right: 0.5rem;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .tabs::-webkit-scrollbar {
    display: none;
  }
  .tab {
    position: relative;
    padding: 0.4rem 0.7rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--muted);
    border-radius: var(--radius-sm);
    white-space: nowrap;
    transition:
      color 0.18s ease,
      background 0.18s ease;
  }
  .tab:hover {
    color: var(--text);
    background: var(--panel-2);
  }
  .tab[data-active='true'] {
    color: var(--text);
  }

  @media (max-width: 680px) {
    .tabs {
      display: none;
    }
    .brand {
      margin-right: auto;
    }
  }
</style>

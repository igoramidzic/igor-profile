---
import Logo from './Logo.astro';

const stack = ['SwiftUI', 'Angular', 'Convex'];

const stats = [
  { value: '$300', label: 'monthly revenue' },
  { value: 'iPhone', label: '+ web app' },
  { value: 'Solo', label: 'designed & built' },
];
---

<section id="kualia" class="kualia" aria-label="Kualia">
  <div class="kualia-inner panel reveal">
    <div class="kualia-glow" aria-hidden="true"></div>

    <div class="kualia-grid">
      <!-- left: copy -->
      <div class="kualia-copy">
        <div class="kualia-head">
          <span class="kualia-logo">
            <Logo src="/logos/kualia.jpg" alt="Kualia" size={40} />
          </span>
          <div>
            <p class="kualia-kicker">Flagship project · Founder &amp; Engineer</p>
            <h2 class="kualia-title">Kualia</h2>
          </div>
          <span class="kualia-badge">
            <span class="dot-live"></span> Live on the App Store
          </span>
        </div>

        <p class="kualia-desc">
          A <strong>budgeting app</strong> that helps people give every dollar a
          job and feel in control of their money. I came up with the idea,
          designed it, built it, and launched it, entirely on my own.
        </p>

        <p class="kualia-desc dim">
          I built the iPhone app with <span class="accent">SwiftUI</span>, the
          website with <span class="accent">Angular</span>, and the system that
          powers them with <span class="accent">Convex</span>. I make the product
          decisions too, guided by what real users tell me. Today it earns $300 in
          recurring revenue every month.
        </p>

        <ul class="kualia-stack">
          {stack.map((s) => <li class="chip">{s}</li>)}
        </ul>

        <div class="kualia-cta">
          <a class="btn-primary" href="https://kualia.com" target="_blank" rel="noopener">
            Visit Kualia ↗
          </a>
        </div>
      </div>

      <!-- right: screenshot (image already includes the device) -->
      <div class="kualia-media">
        <img
          class="kualia-shot"
          src="/images/kualia-screenshot.png"
          alt="Kualia app screenshot"
        />
        <div class="kualia-stats">
          {
            stats.map((s) => (
              <div class="stat">
                <span class="stat-value">{s.value}</span>
                <span class="stat-label">{s.label}</span>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .kualia {
    max-width: 1100px;
    margin: 0 auto;
    padding: clamp(2rem, 6vh, 4rem) clamp(1rem, 4vw, 2rem);
  }
  .kualia-inner {
    position: relative;
    overflow: hidden;
    padding: clamp(1.5rem, 4vw, 3rem);
  }
  .kualia-glow {
    position: absolute;
    top: -40%;
    right: -10%;
    width: 60%;
    height: 120%;
    background: radial-gradient(
      circle,
      var(--accent-glow) 0%,
      transparent 65%
    );
    pointer-events: none;
  }
  .kualia-grid {
    position: relative;
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
  }
  .kualia-head {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin-bottom: 1.2rem;
  }
  .kualia-logo {
    flex: none;
    display: grid;
    place-items: center;
    width: 54px;
    height: 54px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--panel-2);
    overflow: hidden;
  }
  .kualia-kicker {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .kualia-title {
    font-size: clamp(1.6rem, 4vw, 2.2rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .kualia-badge {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.72rem;
    color: var(--text-dim);
    background: var(--panel-2);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.25rem 0.65rem;
    white-space: nowrap;
  }
  .dot-live {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--green);
  }
  .kualia-desc {
    font-size: 0.95rem;
    color: var(--text);
    line-height: 1.7;
    margin-bottom: 0.9rem;
  }
  .kualia-desc.dim {
    font-size: 0.86rem;
    color: var(--text-dim);
  }
  .accent {
    color: var(--accent);
  }
  .kualia-stack {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    padding: 0;
    margin: 1.1rem 0 1.4rem;
  }
  .chip {
    font-size: 0.74rem;
    color: var(--text-dim);
    background: var(--panel-2);
    border: 1px solid var(--border);
    border-radius: 7px;
    padding: 0.2rem 0.6rem;
  }
  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 700;
    font-size: 0.88rem;
    color: var(--bg);
    background: var(--accent);
    border-radius: 9px;
    padding: 0.6rem 1.1rem;
    transition:
      background 0.2s ease,
      transform 0.15s ease,
      box-shadow 0.2s ease;
  }
  .btn-primary:hover {
    background: var(--accent-soft);
    transform: translateY(-2px);
    box-shadow: 0 10px 30px -12px var(--accent-glow);
  }

  /* screenshot */
  .kualia-media {
    display: grid;
    gap: 1.2rem;
    justify-items: center;
  }
  .kualia-shot {
    width: min(240px, 80%);
    height: auto;
    filter: drop-shadow(0 12px 24px rgba(0, 0, 0, 0.35));
  }
  .kualia-stats {
    display: flex;
    gap: 1.4rem;
  }
  .stat {
    text-align: center;
  }
  .stat-value {
    display: block;
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--accent);
  }
  .stat-label {
    font-size: 0.68rem;
    color: var(--muted);
  }

  @media (max-width: 820px) {
    .kualia-grid {
      grid-template-columns: 1fr;
    }
    .kualia-media {
      order: -1;
    }
  }
</style>
